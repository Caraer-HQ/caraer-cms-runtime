---
/**
 * Renders a Caraer form.
 *
 * Server-rendered as a real `<form>` so it works before JavaScript loads and is
 * visible to crawlers; a small script upgrades it to an inline async submit.
 * Submissions go through `/caraer/form/{uuid}` on this server rather than
 * straight to the backend, which keeps the API base URL, tenant headers and
 * company uuid off the client.
 */
import type { CaraerForm as FormData, CaraerLocals } from '../locals.ts';
import FormLayout from './FormLayout.astro';
import { compatibleFormInput } from '../form-inputs.ts';
import { resolveFieldValues } from '../fields.ts';

interface Props {
  /** Form uuid or machine name. */
  form: string;
  formData?: FormData;
  preview?: boolean;
  class?: string;
  submitLabel?: string;
  /** Page record. Sent so form relations such as the vacancy link can be created. */
  recordUuid?: string | null;
  /** Optional URL or path. Used after a successful submission. */
  redirect?: string | null;
}

const { form: formRef, formData, preview = false, class: className, submitLabel, recordUuid, redirect } = Astro.props;

function destination(value: string | null | undefined): string | null {
  const trimmed = value?.trim();
  if (!trimmed) return null;
  if (trimmed.startsWith('/') && !trimmed.startsWith('//')) return trimmed;
  try {
    const url = new URL(trimmed);
    if (url.protocol === 'http:' || url.protocol === 'https:') return url.toString();
  } catch {
    return null;
  }
  return null;
}

const locals = Astro.locals as unknown as CaraerLocals;
const loadedForm = formData ?? await locals.getForm(formRef);
const form = loadedForm ? structuredClone(loadedForm) : null;
const resolved = form?.module ? locals.resolveFormModule?.(form.module) : null;
if (form && resolved) for (const step of form.steps) {
  const resolve = (field: import('../locals.ts').CaraerFormField) => {
    const schema = resolved.manifest.inputs?.find(input => input.name === field.input);
    return schema ? {...field, inputFields: resolveFieldValues(schema.fields ?? [], field.inputFields ?? {}, null)} : field;
  };
  step.fields = step.fields.map(resolve);
  step.rows = step.rows?.map(row => row.map(resolve));
}
const Module = resolved?.component as any;
const invalid = !!form?.module && (!resolved || resolved.manifest.kind !== 'form' || form.steps.some(step => step.fields.some(field => field.input && (!field.id || !resolved.manifest.inputs?.some(input => input.name === field.input && compatibleFormInput(input, field))))));
const idPrefix = `caraer-${crypto.randomUUID()}`;
const moduleFields = resolved ? resolveFieldValues(resolved.manifest.fields, form?.moduleFields ?? {}, null) : {};


// A form is a leaf: if it cannot load, render nothing rather than a broken
// shell. The page around it stays valid.
const steps = form?.steps ?? [];
const wizard = Boolean(form?.wizard && steps.length > 1);
const hasRequired = steps.some((step) => step.fields.some((field) => field.required));
const redirectTo = destination(redirect) ?? destination(form?.redirectUrl);

---

{
  form && (!invalid || preview) && (
    <form
      data-preview={preview ? "true" : undefined}
      novalidate
      class:list={['caraer-form', className]}
      method="post"
      action={preview ? "/caraer/form-preview" : `/caraer/form/${form.uuid}`}
      enctype="multipart/form-data"
      data-caraer-form={form.uuid}
      data-thank-you={form.thankYouMessage ?? undefined}
      data-redirect={redirectTo ?? undefined}
      data-wizard={wizard ? 'true' : undefined}
    >
      {recordUuid && (
        <input type="hidden" name="conversionPageRecordUuid" value={recordUuid} />
      )}
      {redirectTo && <input type="hidden" name="caraerRedirect" value={redirectTo} />}
      {Module ? <Module form={form} fields={moduleFields} rawFields={form.moduleFields ?? {}} idPrefix={idPrefix} preview={preview} /> : <FormLayout form={form} idPrefix={idPrefix} preview={preview} />}

      {wizard && (
        <div class="caraer-form__nav">
          <button type="button" data-wizard-prev hidden>Terug</button>
          <button type="button" data-wizard-next>Volgende</button>
        </div>
      )}
      {hasRequired && <p class="caraer-form__required">* vereiste velden</p>}
      <button type="submit">{submitLabel ?? form.submitLabel ?? 'Verzenden'}</button>
      <p class="caraer-form__status" role="status" aria-live="polite" hidden />
    </form>
  )
}

{invalid && <p role="alert">This form is unavailable. Please check its module and input bindings.</p>}
<script>
  import { mountForms } from '../form-browser.ts';
  mountForms();
  document.addEventListener('astro:page-load', mountForms);
  new MutationObserver(mountForms).observe(document.documentElement, {childList: true, subtree: true});
</script>

<style is:global>
  .caraer-form {
    display: grid;
    gap: var(--caraer-space-md);
  }

  .caraer-form__row {
    display: grid;
    grid-template-columns: repeat(var(--form-columns, 1), minmax(0, 1fr));
    gap: var(--caraer-space-md);
    align-items: start;
  }

  .caraer-form__field {
    display: grid;
    gap: var(--caraer-space-2xs);
    min-width: 0;
  }

  .caraer-form label {
    font-family: var(--caraer-font-body);
    font-size: var(--caraer-size-small);
    font-weight: 600;
    color: var(--caraer-color-font);
  }

  .caraer-form input,
  .caraer-form select,
  .caraer-form textarea {
    font: inherit;
    width: 100%;
    box-sizing: border-box;
    padding: var(--caraer-space-xs) var(--caraer-space-sm);
    border: 1px solid var(--caraer-color-gray-400);
    border-radius: var(--caraer-radius-md);
    background: var(--caraer-color-white);
    color: var(--caraer-color-font);
  }

  .caraer-form__checkbox {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    gap: 0.75rem;
    font-family: var(--caraer-font-body);
    font-size: var(--caraer-size-small);
    font-weight: 600;
    color: var(--caraer-color-font);
    cursor: pointer;
  }

  .caraer-form__checkbox input[type='checkbox'] {
    flex-shrink: 0;
    width: auto;
    margin: 0.15em 0 0;
    padding: 0;
    cursor: pointer;
  }

  .caraer-form__checkbox-text {
    flex: 1 1 auto;
    min-width: 0;
    line-height: 1.4;
  }

  .caraer-form__file {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--caraer-space-sm);
    min-height: 2.75rem;
    padding: 0.35rem 1rem;
    border: 1px solid var(--caraer-color-gray-400);
    border-radius: var(--caraer-radius-md);
    background: var(--caraer-color-white);
  }

  .caraer-form__file input {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    opacity: 0;
    cursor: pointer;
  }

  .caraer-form__file-hint {
    color: var(--caraer-color-gray-500);
    font-size: var(--caraer-size-small);
    font-weight: 400;
  }

  .caraer-form__file-button {
    flex-shrink: 0;
    color: var(--caraer-color-primary);
    font-size: var(--caraer-size-small);
    font-weight: 600;
  }

  .caraer-form__required {
    margin: 0;
    color: var(--form-label-color, var(--caraer-color-font));
    font-size: var(--caraer-size-small);
  }

  @media (max-width: 640px) {
    .caraer-form__row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .caraer-form input:focus-visible,
  .caraer-form select:focus-visible,
  .caraer-form textarea:focus-visible {
    outline: 2px solid var(--caraer-color-primary);
    outline-offset: 1px;
  }

  .caraer-form small {
    color: var(--caraer-color-gray-700);
    font-size: var(--caraer-size-small);
  }

  .caraer-form button {
    justify-self: start;
    font-family: var(--caraer-font-button);
    font-size: var(--caraer-size-button);
    font-weight: var(--caraer-weight-button);
    padding: var(--caraer-space-sm) var(--caraer-space-lg);
    border: 0;
    border-radius: var(--caraer-radius-md);
    background: var(--caraer-color-primary);
    color: var(--caraer-color-white);
    cursor: pointer;
  }

  .caraer-form button[disabled] {
    opacity: 0.6;
    cursor: progress;
  }
</style>
